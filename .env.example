# Copy to apps/web/.env.local (web) and apps/mobile/.env (mobile). Full descriptions in docs/ENV.md.

# --- Supabase (web) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...        # or legacy anon key
SUPABASE_SECRET_KEY=sb_secret_...                              # server only; or legacy service_role key
SUPABASE_DB_URL=                                               # optional: hosted DB URL for `pnpm db:types`

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
SHARE_LINK_COOKIE_SECRET=change-me-32-bytes-random
CRON_SECRET=change-me-random

# --- Stripe (optional until billing goes live; code no-ops with a banner when absent) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Email (optional; invite link is shown for copy/paste when absent) ---
RESEND_API_KEY=
RESEND_FROM=Church App <no-reply@example.org>

# --- Mobile (apps/mobile/.env) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
EXPO_PUBLIC_WEB_URL=https://your-app.vercel.app
EAS_PROJECT_ID=
# GOOGLE_SERVICES_JSON is an EAS *file* environment variable pointing at google-services.json (gitignored)

# --- Local database (scripts/db) ---
DATABASE_URL=postgresql://churchapp_owner:churchapp@127.0.0.1:5432/churchapp?sslmode=disable
